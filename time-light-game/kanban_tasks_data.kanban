		},
		{
			"uuid": "63559c3b-4bf4-4a5e-a537-4f7a80ddcef5",
			"title": "Tutorial Enabler",
			"description": "Make a area3d that can enable the hud elements for abilities and pauses.  It should also have toggles that when its entered can give the ability to resume time, stop time, the dash, and the shoot.  I should export these so I can set which area3d gives what parts back for tutorial2.  By default we want to have these all enabled unless its a level group and a tutorial group on the tree root",
			"category": "14bc8dfc-382b-4779-a576-ff565ed63cbd",
			"steps": []
		},
		{
			"uuid": "df4e23bf-31c5-44a7-96eb-7308a3ad3e50",
			"title": "Wrap up tutorial 2",
